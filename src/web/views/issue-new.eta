<section class="repo-shell"><header class="repo-header"><div><p class="eyebrow"><%= it.repository.ownerSlug %>/<%= it.repository.slug %></p><h1>New issue</h1></div></header>
  <form method="post" action="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/issues" class="form-stack">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <label>Title<input name="title" required maxlength="255"></label>
    <label>Description<textarea name="body" rows="8" maxlength="65536"></textarea></label>
    <% if (it.labels.length) { %><fieldset><legend>Labels</legend><% it.labels.forEach(function(label) { %><label class="inline"><input type="checkbox" name="label:<%= label.id %>" value="on"> <span class="issue-label" style="background:#<%= label.color %>"><%= label.name %></span></label><% }) %></fieldset><% } %>
    <label>Assignee <span class="muted">optional</span><input name="assignee" placeholder="username" maxlength="39"></label>
    <button class="button primary" type="submit">Create issue</button>
  </form>
</section>
