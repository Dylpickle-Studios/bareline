<section class="repo-shell">
  <header><p class="eyebrow">Explore</p><h1>Repositories you can access</h1><p class="muted">Private repositories appear only when your account has permission.</p></header>
  <form class="explore-filter" method="get" role="search"><label><span class="sr-only">Filter repositories</span><input type="search" name="q" value="<%= it.query %>" placeholder="Filter by name or description" maxlength="100" autocomplete="off"></label><button class="button" type="submit">Filter</button><% if (it.query) { %><a class="quiet" href="/explore">Clear</a><% } %></form>
  <% if (!it.repositories.length) { %><div class="empty"><h2><%= it.query ? 'No repositories match that filter' : 'No repositories to show' %></h2><% if (it.user && !it.query) { %><p><a class="button primary" href="/repositories/new">Create the first repository</a></p><% } %></div><% } %>
  <ul class="repository-list"><% it.repositories.forEach(function(repository) { %><li><div><a class="commit-subject" href="/<%= repository.ownerSlug %>/<%= repository.slug %>"><%= repository.ownerSlug %>/<%= repository.slug %></a><% if (repository.description) { %><p><%= repository.description %></p><% } %></div><span class="status"><%= repository.visibility %><% if (repository.archivedAt) { %> · archived<% } %></span></li><% }) %></ul>
  <% if (it.page > 1 || it.hasNext) { %><nav class="pagination" aria-label="Repository pages"><% if (it.page > 1) { %><a class="button" href="?q=<%= encodeURIComponent(it.query) %>&page=<%= it.page - 1 %>" rel="prev">Previous</a><% } %><span class="muted">Page <%= it.page %></span><% if (it.hasNext) { %><a class="button" href="?q=<%= encodeURIComponent(it.query) %>&page=<%= it.page + 1 %>" rel="next">Next</a><% } %></nav><% } %>
</section>
