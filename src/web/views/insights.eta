<% function hue(value) { let h = 0; for (let i = 0; i < value.length; i += 1) h = (h * 31 + value.charCodeAt(i)) >>> 0; return h % 360; } %>
<section class="repo-shell">
  <header><p class="eyebrow"><%= it.repository.ownerSlug %>/<%= it.repository.slug %></p><h1>Insights</h1></header>
  <p class="muted"><%= it.forkCount %> fork<%= it.forkCount === 1 ? '' : 's' %></p>
  <h2>Languages</h2>
  <% if (!it.languages.length) { %><p class="muted">No recognized source files on <%= it.ref %>.</p><% } else { %>
    <div class="language-bar"><% it.languages.forEach(function(stat) { %><span style="inline-size: <%= stat.percent.toFixed(2) %>%; background: hsl(<%= hue(stat.language) %> 60% 45%)" title="<%= stat.language %> · <%= stat.percent.toFixed(1) %>%"></span><% }) %></div>
    <ul class="language-legend">
      <% it.languages.forEach(function(stat) { %><li><span class="language-swatch" style="background: hsl(<%= hue(stat.language) %> 60% 45%)"></span><%= stat.language %> <span class="muted"><%= stat.percent.toFixed(1) %>%</span></li><% }) %>
    </ul>
  <% } %>
  <h2>Contributors</h2>
  <% if (!it.contributors.length) { %><p class="muted">No commits on <%= it.ref %>.</p><% } %>
  <ol class="commit-list compact">
    <% it.contributors.forEach(function(contributor) { %><li><div><span><%= contributor.name %></span><p class="muted"><%= contributor.email %></p></div><span><%= contributor.commits %> commit<%= contributor.commits === 1 ? '' : 's' %></span></li><% }) %>
  </ol>
</section>
