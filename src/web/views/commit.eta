<section class="repo-shell">
  <header><p class="eyebrow">Commit <%= it.commit.shortId %></p><h1><%= it.commit.subject %></h1><p class="muted"><% if (it.commit.avatarUrl) { %><img class="commit-avatar" src="<%= it.commit.avatarUrl %>" width="32" height="32" alt=""><% } %><%= it.commit.authorName %> authored <time datetime="<%= it.commit.authoredAt %>" title="<%= it.commit.authoredAt %>"><%= it.commit.authoredAt %></time></p></header>
  <pre class="commit-message"><%= it.commit.message %></pre>
  <dl class="commit-metadata"><div><dt>Commit</dt><dd><code><%= it.commit.objectId %></code></dd></div><div><dt>Tree</dt><dd><a class="sha" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>?ref=<%= it.commit.objectId %>"><%= it.commit.treeId.slice(0, 12) %></a></dd></div><div><dt>Author</dt><dd><%= it.commit.authorName %> &lt;<%= it.commit.authorEmail %>&gt; · <time datetime="<%= it.commit.authoredAt %>"><%= it.commit.authoredAt %></time></dd></div><div><dt>Committer</dt><dd><%= it.commit.committerName %> · <time datetime="<%= it.commit.committedAt %>"><%= it.commit.committedAt %></time></dd></div><div><dt>Signature</dt><dd><span class="signature signature-<%= it.commit.signature.state %>"><%= it.commit.signature.label %></span><% if (it.commit.signature.signer) { %> · <%= it.commit.signature.signer %><% } %><% if (it.commit.signature.fingerprint) { %><br><code><%= it.commit.signature.fingerprint %></code><% } %><br><span class="muted">Cryptographic validity does not establish identity trust.</span></dd></div><% if (it.commit.parents.length) { %><div><dt>Parents</dt><dd><% it.commit.parents.forEach(function(parent) { %><a class="sha" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commit/<%= parent %>"><%= parent.slice(0, 12) %></a> <% }) %></dd></div><% } %></dl>
  <div class="diff-summary"><strong><%= it.commit.filesChanged %> files</strong><span class="addition">+<%= it.commit.additions %></span><span class="deletion">−<%= it.commit.deletions %></span><a class="button" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commit/<%= it.commit.objectId %>/patch">Download patch</a></div>
  <% if (it.canWrite) { %>
  <div class="commit-actions"><form method="post" action="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commit/<%= it.commit.objectId %>/cherry-pick"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label>Cherry-pick onto<select name="branch"><% it.branches.forEach(function(branch) { %><option value="<%= branch.name %>"><%= branch.name %></option><% }) %></select></label><button class="button" type="submit">Cherry-pick</button></form><form method="post" action="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commit/<%= it.commit.objectId %>/revert"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label>Revert onto<select name="branch"><% it.branches.forEach(function(branch) { %><option value="<%= branch.name %>"><%= branch.name %></option><% }) %></select></label><button class="button" type="submit">Revert</button></form></div>
  <% } %>
  <nav class="diff-file-nav" aria-label="Changed files"><% it.commit.diffFiles.forEach(function(file) { %><a href="#<%= file.anchor %>"><%= file.newPath %></a><% }) %></nav>
  <div class="diff-toolbar" role="group" aria-label="Diff layout"><button class="quiet" type="button" data-diff-mode="unified">Unified</button><button class="quiet" type="button" data-diff-mode="split">Split</button></div>
  <% if (it.commit.truncated) { %><div class="notice" data-diff-notice><strong>This diff was truncated for performance.</strong><p><span data-diff-lines><%= it.commit.diff.split('\n').length %></span> lines are currently shown. Loading the bounded full diff may use significant browser memory and server resources.</p><div class="actions"><button class="button" type="button" data-diff-more data-endpoint="/api/v1/repositories/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commits/<%= it.commit.objectId %>/diff">Load more</button><button class="button" type="button" data-diff-full data-endpoint="/api/v1/repositories/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commits/<%= it.commit.objectId %>/diff">Load bounded full diff</button></div></div><% } %>
  <div data-diff-files>
    <% it.commit.diffFiles.forEach(function(file) { %>
      <details class="diff-file" id="<%= file.anchor %>" open>
        <summary><strong><%= file.newPath %></strong><span><%= file.status %> · +<%= file.additions %> −<%= file.deletions %></span><button class="quiet" data-copy="<%= file.newPath %>" type="button">Copy path</button></summary>
        <% if (file.imageDiff) { %>
          <div class="image-diff"><div class="image-diff-sides">
            <% ['old', 'new'].forEach(function(sideName) { const side = file.imageDiff[sideName]; %>
              <figure><figcaption><%= sideName === 'old' ? 'Before' : 'After' %><% if (side && side.metadata) { %> · <%= side.metadata.width %> × <%= side.metadata.height %> · <%= side.size %> bytes<% } %></figcaption><% if (side) { %><img src="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/raw/<%= side.encodedPath %>?ref=<%= encodeURIComponent(side.ref) %>" alt="<%= sideName === 'old' ? 'Before' : 'After' %> image for <%= side.path %>"><% } else { %><span class="image-missing">No image</span><% } %></figure>
            <% }) %>
          </div>
          <% if (file.imageDiff.old && file.imageDiff.new) { %><div class="image-overlay" data-image-overlay><img src="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/raw/<%= file.imageDiff.old.encodedPath %>?ref=<%= encodeURIComponent(file.imageDiff.old.ref) %>" alt="Before image"><img class="image-overlay-after" src="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/raw/<%= file.imageDiff.new.encodedPath %>?ref=<%= encodeURIComponent(file.imageDiff.new.ref) %>" alt="After image"><label>Overlay position<input type="range" min="0" max="100" value="50" data-image-slider></label></div><% } %></div>
        <% } else if (file.binary) { %><p class="binary-state">Binary file changed. Inline decoding is disabled unless a protected preview is available.</p><% } %>
        <% if (file.truncated) { %><p class="notice">This individual file diff reached the configured per-file byte limit.</p><% } %>
        <% file.hunks.forEach(function(hunk) { %><section class="diff-hunk" id="<%= hunk.anchor %>"><a class="hunk-anchor" href="#<%= hunk.anchor %>"><%= hunk.header %></a><pre class="diff" data-diff-unified><code><%= hunk.lines.join('\n') %></code></pre><div class="split-diff" data-diff-split hidden data-header="<%= hunk.header %>" data-lines="<%= hunk.lines.join('\n') %>"></div></section><% }) %>
      </details>
    <% }) %>
  </div>
</section>
