<section class="settings-shell"><nav class="settings-nav" aria-label="User settings"><a aria-current="page" href="/settings/profile">Profile</a><a href="/settings/credentials">Git credentials</a><a href="/settings/appearance">Appearance</a><a href="/settings/sessions">Sessions</a></nav><div class="settings-content"><h1>Profile</h1><div class="profile-avatar"><% if (it.profile.hasAvatar) { %><img src="/avatars/<%= it.user.username %>" width="96" height="96" alt=""><% } else { %><span class="avatar-placeholder" aria-hidden="true"><%= it.user.displayName.slice(0, 1).toUpperCase() %></span><% } %></div><form method="post" class="form-stack"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label>Display name<input name="displayName" value="<%= it.profile.displayName %>" maxlength="100" required></label><label>Email<input name="email" type="email" value="<%= it.profile.email ?? '' %>" maxlength="400"></label><label class="inline"><input name="emailPublic" type="checkbox" value="yes" <%= it.profile.emailPublic ? 'checked' : '' %>> Show my email publicly</label><button class="button" type="submit">Save profile</button></form><form method="post" action="/settings/avatar" enctype="multipart/form-data" class="form-stack"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label>Avatar image<input name="avatar" type="file" accept="image/png,image/jpeg,image/gif,image/webp" required></label><p class="muted">PNG, JPEG, GIF, or WebP; maximum 512 KiB. SVG is not accepted.</p><button class="button" type="submit">Upload avatar</button></form><% if (it.profile.hasAvatar) { %><form method="post" action="/settings/avatar/remove"><input type="hidden" name="csrf" value="<%= it.csrf %>"><button class="quiet danger" type="submit">Remove avatar</button></form><% } %></div></section>
