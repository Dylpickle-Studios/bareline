<section class="admin-shell">
  <nav class="settings-nav" aria-label="Administration"><a href="/admin">Overview</a><a aria-current="page" href="/admin/plugins">Plugins</a><a href="/admin/plugins/playground">Playground</a><a href="/admin/audit">Audit log</a><a href="/admin/search">Search index</a></nav>
  <div class="settings-content"><header><p class="eyebrow">Administration</p><h1>Plugins</h1></header><p><a class="button" href="/docs/plugins/example">Download example plugin</a></p>
    <section><h2>Install local package</h2><p class="muted">The directory is read by the server and copied into managed storage. Trusted plugins are equivalent to installing server software.</p><form method="post" action="/admin/plugins/install" class="credential-form"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label>Server directory<input name="source" required></label><label class="inline"><input type="checkbox" name="trustedRisk" value="accepted"> I accept trusted-code host risk</label><button class="button" type="submit">Validate and install</button></form></section>
    <section><h2>Upload package</h2><p class="muted">Upload the normalized <code>.tar.gz</code> plugin package format. Paths, checksums, file types, counts, and expanded size are validated before installation.</p><form method="post" action="/admin/plugins/upload" enctype="multipart/form-data" class="credential-form"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label>Plugin archive<input type="file" name="archive" accept="application/gzip,.tgz,.tar.gz" required></label><label class="inline"><input type="checkbox" name="trustedRisk" value="accepted"> I accept trusted-code host risk</label><button class="button" type="submit">Validate and install archive</button></form></section>
    <section><h2>Install allowlisted remote package</h2><p class="muted">Git hosts and npm package names must first be allowlisted in configuration. Package scripts never run during retrieval.</p><form method="post" action="/admin/plugins/remote" class="credential-form"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label>Source type<select name="sourceType"><option value="npm">npm package</option><option value="git">HTTPS Git repository</option></select></label><label>Package or URL<input name="source" required></label><label>Git ref<input name="ref" value="main"></label><label class="inline"><input type="checkbox" name="trustedRisk" value="accepted"> I accept trusted-code host risk</label><button class="button" type="submit">Fetch, validate, and install</button></form></section>
    <div class="plugin-grid"><% it.plugins.forEach(function(plugin) { %><article class="plugin-card"><header><div><h2><%= plugin.name %></h2><p><code><%= plugin.id %></code> · <%= plugin.version %></p></div><span class="status"><%= plugin.enabled ? 'Enabled' : 'Disabled' %> · <%= plugin.runtime %></span></header><p>Source: <code><%= plugin.sourceType %>:<%= plugin.sourceValue %></code></p>
      <% if (plugin.runtime === 'trusted') { %><div class="notice error"><strong>Trusted Node code can compromise the entire host.</strong> Permission switches cannot contain malicious trusted code.</div><% } %>
      <% if (plugin.enabled && plugin.manifest.contributes.adminPages.length && plugin.permissions.some(function(permission) { return permission.capability === 'ui.global' && permission.granted; }) && plugin.permissions.some(function(permission) { return permission.capability === 'settings.read' && permission.granted; })) { %><h3>Administration integrations</h3><div class="actions"><% plugin.manifest.contributes.adminPages.forEach(function(page) { %><a class="button" href="/admin/plugins/<%= plugin.id %>/pages/<%= page.id %>"><%= page.title %></a><% }) %></div><% } %>
      <h3>Permissions</h3><ul class="permission-list"><% plugin.permissions.forEach(function(permission) { %><li><span><%= permission.granted ? '✓' : '✕' %> <%= permission.capability %></span><form method="post" action="/admin/plugins/<%= plugin.id %>/permissions"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="capability" value="<%= permission.capability %>"><input type="hidden" name="granted" value="<%= permission.granted ? 'no' : 'yes' %>"><button class="quiet" type="submit"><%= permission.granted ? 'Deny' : 'Allow' %></button></form></li><% }) %></ul>
      <% if (Object.keys(plugin.manifest.settings).length) { %><button class="button" type="button" data-dialog-open="plugin-settings-<%= plugin.id %>">Settings</button><dialog id="plugin-settings-<%= plugin.id %>" class="settings-dialog" aria-labelledby="plugin-settings-title-<%= plugin.id %>"><header><h2 id="plugin-settings-title-<%= plugin.id %>"><%= plugin.name %> settings</h2><form method="dialog"><button class="quiet" aria-label="Close settings">Close</button></form></header><form method="post" action="/admin/plugins/<%= plugin.id %>/settings" class="form-stack"><input type="hidden" name="csrf" value="<%= it.csrf %>"><% Object.entries(plugin.manifest.settings).forEach(function(pair) { const key = pair[0], setting = pair[1], current = plugin.settings[key]; %><label><%= setting.title %><% if (setting.type === 'boolean') { %><select name="setting.<%= key %>"><option value="true" <%= current.value === true ? 'selected' : '' %>>Yes</option><option value="false" <%= current.value === false ? 'selected' : '' %>>No</option></select><% } else if (setting.type === 'select' || setting.type === 'multi-select') { %><select name="setting.<%= key %>" <%= setting.type === 'multi-select' ? 'multiple' : '' %>><% setting.options.forEach(function(option) { const selected = setting.type === 'multi-select' ? Array.isArray(current.value) && current.value.includes(option) : current.value === option; %><option value="<%= option %>" <%= selected ? 'selected' : '' %>><%= option %></option><% }) %></select><% } else { %><input name="setting.<%= key %>" type="<%= setting.type === 'secret' ? 'password' : setting.type === 'number' ? 'number' : setting.type === 'url' ? 'url' : 'text' %>" value="<%= setting.type === 'secret' ? '' : current.value ?? '' %>" placeholder="<%= setting.type === 'secret' && current.configured ? 'Configured; leave blank to keep' : '' %>"><% } %></label><% }) %><button class="button" type="submit">Save settings</button></form></dialog><% } %>
      <div class="actions"><form method="post" action="/admin/plugins/<%= plugin.id %>/enabled"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="enabled" value="<%= plugin.enabled ? 'no' : 'yes' %>"><% if (plugin.runtime === 'trusted' && !plugin.enabled) { %><label class="inline"><input type="checkbox" name="trustedRisk" value="accepted" required> Accept host risk</label><% } %><button class="button" type="submit"><%= plugin.enabled ? 'Disable' : 'Enable' %></button></form><form method="post" action="/admin/plugins/<%= plugin.id %>/remove"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label class="inline"><input type="checkbox" name="keepData" value="yes" checked> Keep data</label><button class="button danger" data-confirm="Remove this plugin package?" type="submit">Remove</button></form></div>
    </article><% }) %></div>
  </div>
</section>
