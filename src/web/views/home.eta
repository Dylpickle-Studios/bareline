<section class="hero">
  <p class="eyebrow">Git, without the clutter</p>
  <h1>A focused home for your repositories.</h1>
  <p>Browse code, understand history, and move work over SSH or HTTPS—without project-management machinery getting in the way.</p>
  <div class="actions">
    <% if (it.user) { %><a class="button primary" href="/repositories/new">Create repository</a><% } else { %>
    <a class="button primary" href="/register">Create your account</a><a class="button" href="/login">Sign in</a><% } %>
  </div>
</section>
<% if (it.user && (it.pinnedRepositories.length || it.recentRepositories.length)) { %><section class="repo-shell"><div class="settings-sections"><% if (it.pinnedRepositories.length) { %><section><h2>Pinned repositories</h2><ul class="credential-list"><% it.pinnedRepositories.forEach(function(repository) { %><li><a href="/<%= repository.ownerSlug %>/<%= repository.slug %>"><strong><%= repository.ownerSlug %>/<%= repository.slug %></strong></a><span><%= repository.description %></span></li><% }) %></ul></section><% } %><% if (it.recentRepositories.length) { %><section><h2>Recently viewed</h2><ul class="credential-list"><% it.recentRepositories.forEach(function(repository) { %><li><a href="/<%= repository.ownerSlug %>/<%= repository.slug %>"><strong><%= repository.ownerSlug %>/<%= repository.slug %></strong></a></li><% }) %></ul></section><% } %></div></section><% } %>
