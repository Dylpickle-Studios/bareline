<section class="admin-shell"><nav class="settings-nav" aria-label="Administration"><a href="/admin">Overview</a><a href="/admin/users">Users</a><a aria-current="page" href="/admin/invites">Invites</a><a href="/admin/repositories">Repositories</a><a href="/admin/plugins">Plugins</a><a href="/admin/audit">Audit log</a></nav><div class="settings-content"><h1>Registration invites</h1><p>Invite links are single-use and expire automatically. The token is shown only once.</p><form method="post" class="credential-form"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="create"><label>Expires after<select name="days"><option value="1">1 day</option><option value="7" selected>7 days</option><option value="30">30 days</option></select></label><button class="button" type="submit">Create invite</button></form><% if (it.createdUrl) { %><div class="one-time-secret" role="status"><strong>Copy this invite URL now. It will not be shown again.</strong><code><%= it.createdUrl %></code><button class="button" type="button" data-copy="<%= it.createdUrl %>">Copy URL</button></div><% } %><ul class="credential-list"><% it.invites.forEach(function(invite) { %><li><span>Invite <%= invite.id %> · expires <time datetime="<%= invite.expiresAt %>"><%= invite.expiresAt %></time> · <%= invite.usedAt ? 'Used' : 'Unused' %></span><% if (!invite.usedAt) { %><form method="post"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="revoke"><input type="hidden" name="inviteId" value="<%= invite.id %>"><button class="quiet danger" type="submit">Revoke</button></form><% } %></li><% }) %></ul></div></section>
