<section class="settings-shell">
  <nav class="settings-nav" aria-label="User settings"><a href="/settings/profile">Profile</a><a aria-current="page" href="/settings/credentials">Git credentials</a><a href="/settings/appearance">Appearance</a><a href="/settings/sessions">Sessions</a></nav>
  <div class="settings-content">
    <header><p class="eyebrow">User settings</p><h1>Git credentials</h1></header>
    <% if (it.pendingTransfers.length) { %><section><h2>Pending repository transfers</h2><p class="muted">Accepting makes your account the repository owner. Requests expire automatically.</p><ul class="credential-list"><% it.pendingTransfers.forEach(function(transfer) { %><li><div><strong><%= transfer.owner %>/<%= transfer.repository %></strong><p>Requested by <%= transfer.requestedBy %> · expires <time datetime="<%= transfer.expiresAt %>"><%= transfer.expiresAt %></time></p></div><div class="actions"><form method="post" action="/settings/repository-transfers/<%= transfer.repositoryId %>"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="accept"><button class="button" type="submit">Accept</button></form><form method="post" action="/settings/repository-transfers/<%= transfer.repositoryId %>"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="decline"><button class="quiet" type="submit">Decline</button></form></div></li><% }) %></ul></section><% } %>
    <% if (it.createdToken) { %><div class="one-time-secret" role="status"><strong>Copy this token now. It will not be shown again.</strong><code><%= it.createdToken %></code><button class="button" data-copy="<%= it.createdToken %>" type="button">Copy token</button></div><% } %>
    <% if (it.createdRecoveryCodes) { %><div class="one-time-secret" role="status"><strong>Save these recovery codes now. Each works once and they will not be shown again.</strong><pre><%= it.createdRecoveryCodes.join('\n') %></pre></div><% } %>
    <% if (it.createdTotpBackupCodes) { %><div class="one-time-secret" role="status"><strong>Save these two-factor backup codes now. Each works once and they will not be shown again.</strong><pre><%= it.createdTotpBackupCodes.join('\n') %></pre></div><% } %>
    <section><h2>Account recovery</h2><p><%= it.recoveryCodeCount %> unused recovery codes. Generating a new set invalidates the old set.</p><form method="post" action="/settings/recovery-codes"><input type="hidden" name="csrf" value="<%= it.csrf %>"><button class="button" data-confirm="Replace all existing recovery codes?" type="submit">Generate recovery codes</button></form></section>
    <section><h2>Two-factor authentication</h2>
      <% if (it.totp.enabled) { %>
        <p>Enabled · <%= it.totp.backupCodeCount %> unused backup codes.</p>
        <div class="actions">
          <form method="post" action="/settings/two-factor/backup-codes"><input type="hidden" name="csrf" value="<%= it.csrf %>"><button class="button" data-confirm="Replace all existing backup codes?" type="submit">Regenerate backup codes</button></form>
          <form method="post" action="/settings/two-factor/disable"><input type="hidden" name="csrf" value="<%= it.csrf %>"><button class="quiet danger" data-confirm="Disable two-factor authentication?" type="submit">Disable</button></form>
        </div>
      <% } else { %>
        <p>Require an authenticator app code in addition to your password when signing in.</p>
        <a class="button" href="/settings/two-factor/setup">Set up two-factor authentication</a>
      <% } %>
    </section>
    <section><h2>Passkeys</h2><p>Use a device-bound or synced passkey for phishing-resistant sign-in.</p><div class="credential-form"><label>Passkey name<input id="passkey-name" value="My passkey" maxlength="100"></label><button class="button" type="button" data-passkey-register data-csrf="<%= it.csrf %>">Add passkey</button><span data-passkey-status role="status"></span></div><ul class="credential-list"><% it.passkeyList.forEach(function(passkey) { %><li><form method="post" action="/settings/passkeys/<%= encodeURIComponent(passkey.id) %>" class="inline"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input name="name" value="<%= passkey.name %>" maxlength="100" aria-label="Passkey name"><button class="quiet" name="action" value="rename" type="submit">Rename</button><button class="quiet danger" name="action" value="remove" data-confirm="Remove this passkey?" type="submit">Remove</button></form></li><% }) %></ul></section>
    <section><h2>Personal access tokens</h2><form method="post" action="/settings/tokens" class="credential-form"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label>Name<input name="name" required maxlength="100"></label><label>Access<select name="access"><option value="read">Repository read</option><option value="write">Repository read and write</option><option value="api">API read</option><option value="api-write">API and repository read/write</option></select></label><label>Expires in<select name="expires"><option value="30">30 days</option><option value="90">90 days</option><option value="365">1 year</option></select></label><label>Limit to repository<select name="repository"><option value="">All repositories you can access</option><% it.repositories.forEach(function(repository) { %><option value="<%= repository.id %>"><%= repository.ownerSlug %>/<%= repository.slug %></option><% }) %></select><small>A repository token is refused everywhere else, including your account and administration endpoints. Use one to give a script or an agent access to a single repository.</small></label><button class="button" type="submit">Create token</button></form>
      <ul class="credential-list"><% it.tokens.forEach(function(token) { %><li><div><strong><%= token.name %></strong><p><code>ghp_<%= token.prefix %>_…</code> · <%= token.scopes.join(', ') %> · <%= token.repository ? `limited to ${token.repository}` : 'all repositories' %></p></div><form method="post" action="/settings/tokens/<%= token.id %>/revoke"><input type="hidden" name="csrf" value="<%= it.csrf %>"><button class="quiet danger" data-confirm="Revoke this token?" type="submit">Revoke</button></form></li><% }) %></ul>
    </section>
    <section><h2>SSH keys</h2><form method="post" action="/settings/ssh-keys" class="form-stack"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label>Name<input name="name" required maxlength="100"></label><label>Public key<textarea name="publicKey" rows="4" required placeholder="ssh-ed25519 AAAA…"></textarea></label><button class="button" type="submit">Add SSH key</button></form>
      <ul class="credential-list"><% it.sshKeys.forEach(function(key) { %><li><div><strong><%= key.name %></strong><p><code><%= key.fingerprint %></code></p></div><form method="post" action="/settings/ssh-keys/<%= key.id %>/remove"><input type="hidden" name="csrf" value="<%= it.csrf %>"><button class="quiet danger" data-confirm="Remove this SSH key?" type="submit">Remove</button></form></li><% }) %></ul>
    </section>
  </div>
</section>
