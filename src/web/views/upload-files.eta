<section class="repo-shell"><header><p class="eyebrow"><%= it.repository.ownerSlug %>/<%= it.repository.slug %></p><h1>Upload files</h1></header><form method="post" enctype="multipart/form-data" class="form-stack"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="ref" value="<%= it.ref %>"><label>Target directory<input name="path" value="<%= it.path %>" placeholder="docs"></label><label>Files<input name="files" type="file" multiple required></label><label>Commit message<input name="message" value="Upload files" maxlength="10000" required></label><button class="button primary" type="submit">Commit uploaded files</button></form></section>
