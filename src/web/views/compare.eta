<section class="repo-shell">
  <header><p class="eyebrow">Compare</p><h1><%= it.baseInput %>…<%= it.headInput %></h1><p class="muted">Merge base <span class="sha"><%= it.comparison.mergeBase.slice(0, 8) %></span></p></header>
  <form class="compare-form" method="get"><label>Base<input name="base" value="<%= it.baseInput %>" required></label><label>Head<input name="head" value="<%= it.headInput %>" required></label><button class="button" type="submit">Compare</button></form>
  <div class="diff-summary"><strong><%= it.comparison.filesChanged %> files</strong><span class="addition">+<%= it.comparison.additions %></span><span class="deletion">−<%= it.comparison.deletions %></span><span><%= it.comparison.commits.length %> commits</span></div>
  <% if (it.comparison.commits.length) { %><ol class="commit-list compact"><% it.comparison.commits.forEach(function(commit) { %><li><div><a class="commit-subject" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commit/<%= commit.objectId %>"><%= commit.subject %></a><p><%= commit.authorName %> · <time datetime="<%= commit.authoredAt %>"><%= commit.authoredAt %></time></p></div><a class="sha" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commit/<%= commit.objectId %>"><%= commit.shortId %></a></li><% }) %></ol><% } %>
  <% if (it.comparison.truncated) { %><div class="notice">This comparison was truncated at the configured hard safety limit.</div><% } %>
  <div class="diff-toolbar" role="group" aria-label="Diff layout"><button class="quiet" type="button" data-diff-mode="unified">Unified</button><button class="quiet" type="button" data-diff-mode="split">Split</button></div>
  <div data-diff-files><% it.comparison.diffFiles.forEach(function(file) { %><details class="diff-file" id="<%= file.anchor %>" open><summary><strong><%= file.newPath %></strong><span><%= file.status %> · +<%= file.additions %> −<%= file.deletions %></span><button class="quiet" data-copy="<%= file.newPath %>" type="button">Copy path</button></summary><% if (file.binary) { %><p class="binary-state">Binary file changed.</p><% } %><% if (file.truncated) { %><p class="notice">This individual file diff reached the configured per-file byte limit.</p><% } %><% file.hunks.forEach(function(hunk) { %><section class="diff-hunk" id="<%= hunk.anchor %>"><a class="hunk-anchor" href="#<%= hunk.anchor %>"><%= hunk.header %></a><pre class="diff" data-diff-unified><code><%= hunk.lines.join('\n') %></code></pre><div class="split-diff" data-diff-split hidden data-header="<%= hunk.header %>" data-lines="<%= hunk.lines.join('\n') %>"></div></section><% }) %></details><% }) %></div>
</section>
