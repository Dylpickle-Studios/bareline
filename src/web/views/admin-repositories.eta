<section class="admin-shell">
  <nav class="settings-nav" aria-label="Administration"><a href="/admin">Overview</a><a href="/admin/users">Users</a><a aria-current="page" href="/admin/repositories">Repositories</a><a href="/admin/plugins">Plugins</a><a href="/admin/audit">Audit log</a></nav>
  <div class="settings-content"><h1>Repositories</h1>
    <% if (it.error) { %><div class="notice error" role="alert"><%= it.error %></div><% } %>
    <details open><summary>Import from another Git host</summary><p>Clone every branch and tag from a public HTTPS repository into new Bareline-managed storage. The source hostname must be explicitly allowlisted; credentials, redirects, query strings, and private network destinations are rejected.</p>
      <% if (it.remoteImportEnabled) { %><form method="post" action="/admin/repositories/import-remote/preview" class="form-stack"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label>Source HTTPS URL<input type="url" name="sourceUrl" value="<%= it.values.sourceUrl || '' %>" required placeholder="https://github.com/owner/repository.git"></label><label>Owner type<select name="ownerType"><option value="user" <%= it.values.ownerType !== 'group' ? 'selected' : '' %>>User</option><option value="group" <%= it.values.ownerType === 'group' ? 'selected' : '' %>>Group</option></select></label><label>Owner name<input name="ownerSlug" value="<%= it.values.ownerSlug || '' %>" required></label><label>Repository name<input name="slug" value="<%= it.values.slug || '' %>" required maxlength="39" pattern="[a-z0-9][a-z0-9-]*"></label><label>Description<input name="description" value="<%= it.values.description || '' %>" maxlength="500"></label><label>Visibility<select name="visibility"><option value="private" <%= it.values.visibility !== 'public' ? 'selected' : '' %>>Private</option><option value="public" <%= it.values.visibility === 'public' ? 'selected' : '' %>>Public</option></select></label><button class="button primary" type="submit">Inspect remote</button></form><% } else { %><p class="notice">Remote imports are disabled. Add exact public hostnames under <code>mirrors.allowedHosts</code> and restart Bareline.</p><% } %>
    </details>
    <details><summary>Register existing repository</summary><p>Only exact paths beneath configured import roots are accepted. The server never scans the filesystem.</p><form method="post" action="/admin/repositories/import" class="form-stack"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label>Repository path<input name="sourcePath" required></label><label>Owner type<select name="ownerType"><option value="user">User</option><option value="group">Group</option></select></label><label>Owner name<input name="ownerSlug" required></label><label>Repository name<input name="slug" required></label><label>Description<input name="description" maxlength="500"></label><label>Visibility<select name="visibility"><option value="private">Private</option><option value="public">Public</option></select></label><button class="button" type="submit">Validate and register</button></form></details>
    <div class="responsive-table"><table><thead><tr><th>Repository</th><th>Visibility</th><th>Storage</th><th>Updated</th></tr></thead><tbody><% it.repositories.forEach(function(repository) { %><tr><td><a href="/<%= repository.owner %>/<%= repository.slug %>"><%= repository.owner %>/<%= repository.slug %></a></td><td><%= repository.visibility %></td><td><%= repository.storageKind %></td><td><%= repository.updatedAt %></td></tr><% }) %></tbody></table></div>
  </div>
</section>
