<section class="settings-shell"><nav class="settings-nav" aria-label="User settings"><a href="/settings/credentials">Git credentials</a><a href="/settings/appearance">Appearance</a><a aria-current="page" href="/settings/sessions">Sessions</a></nav><div class="settings-content"><h1>Sessions</h1><p>Revoking other sessions signs out browsers and devices except this one.</p><form method="post"><input type="hidden" name="csrf" value="<%= it.csrf %>"><button class="button danger" data-confirm="Sign out every other session?" type="submit">Log out everywhere else</button></form><ul class="credential-list"><% it.sessions.forEach(function(session) { %><li><div><strong><%= session.userAgent ?? 'Unknown client' %></strong><p>Last used <%= session.lastSeenAt %> · expires <%= session.expiresAt %></p></div></li><% }) %></ul></div></section>
