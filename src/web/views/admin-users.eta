<section class="admin-shell"><nav class="settings-nav" aria-label="Administration"><a href="/admin">Overview</a><a aria-current="page" href="/admin/users">Users</a><a href="/admin/repositories">Repositories</a><a href="/admin/plugins">Plugins</a><a href="/admin/audit">Audit log</a></nav><div class="settings-content"><h1>Users</h1><% if (it.createdRecovery) { %><div class="one-time-secret" role="status"><strong>Give this one-time recovery code to <%= it.createdRecovery.username %> over a verified channel. It replaces their previous recovery codes and will not be shown again.</strong><code><%= it.createdRecovery.code %></code><button class="button" type="button" data-copy="<%= it.createdRecovery.code %>">Copy code</button></div><% } %><div class="responsive-table"><table><thead><tr><th>User</th><th>Status</th><th>Role</th><th>Created</th><th>Actions</th></tr></thead><tbody><% it.users.forEach(function(account) { %><tr><td><strong><%= account.displayName %></strong><br><code><%= account.username %></code></td><td><%= account.status %></td><td><%= account.isAdmin ? 'Administrator' : 'User' %></td><td><time datetime="<%= account.createdAt %>"><%= account.createdAt %></time></td><td><form method="post" action="/admin/users/<%= account.id %>"><input type="hidden" name="csrf" value="<%= it.csrf %>"><button class="quiet" name="action" value="<%= account.status === 'active' ? 'disable' : 'enable' %>" type="submit"><%= account.status === 'active' ? 'Disable' : 'Enable' %></button><button class="quiet" name="action" value="<%= account.isAdmin ? 'demote' : 'promote' %>" type="submit"><%= account.isAdmin ? 'Demote' : 'Promote' %></button><button class="quiet" name="action" value="recovery" data-confirm="Replace this user's recovery codes?" type="submit">Issue recovery code</button></form></td></tr><% }) %></tbody></table></div></div></section>
