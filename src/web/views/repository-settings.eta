<section class="repo-shell"><header class="repo-header"><div><p class="eyebrow"><%= it.repository.ownerSlug %>/<%= it.repository.slug %></p><h1>Repository settings</h1></div><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>">Back to repository</a></header><div class="settings-sections"><section><h2>General</h2><form method="post" class="form-stack"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="details"><label>Description<textarea name="description" maxlength="500"><%= it.repository.description %></textarea></label><label>Default branch<input name="defaultBranch" value="<%= it.repository.defaultBranch %>" required></label><label>Visibility<select name="visibility"><option value="private" <%= it.repository.visibility === 'private' ? 'selected' : '' %>>Private</option><option value="public" <%= it.repository.visibility === 'public' ? 'selected' : '' %>>Public</option></select></label><button class="button" type="submit">Save settings</button></form></section><section><h2>Collaborators</h2><form method="post" class="credential-form"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="grant"><label>Type<select name="principalType"><option value="user">User</option><option value="group">Group</option></select></label><label>Name<input name="principalName" required></label><label>Permission<select name="level"><option value="read">Read</option><option value="write">Write</option><option value="admin">Admin</option></select></label><button class="button" type="submit">Add or update</button></form><ul class="credential-list"><% it.grants.forEach(function(grant) { %><li><span><strong><%= grant.name %></strong> · <%= grant.principalType %> · <%= grant.level %></span><form method="post"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="removeGrant"><input type="hidden" name="principalType" value="<%= grant.principalType %>"><input type="hidden" name="principalId" value="<%= grant.principalId %>"><button class="quiet danger" type="submit">Remove</button></form></li><% }) %></ul></section><section><h2>Rename and transfer</h2><form method="post" class="credential-form"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="rename"><label>Repository name<input name="slug" value="<%= it.repository.slug %>" required></label><button class="button" type="submit">Rename</button></form><form method="post" class="credential-form"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="transfer"><label>Owner type<select name="ownerType"><option value="user">My account</option><option value="group">Group</option></select></label><label>Owner name<input name="ownerSlug" required></label><button class="button" data-confirm="Transfer repository ownership?" type="submit">Transfer</button></form></section><section class="danger-zone"><h2>Danger zone</h2><p>Deletion moves hosted Git data to configured trash. Imported repositories are unregistered without deleting their source.</p><form method="post"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="delete"><label>Type the repository name<input name="confirmation" required></label><button class="button danger" data-confirm="Move this repository to trash?" type="submit">Delete repository</button></form></section></div></section>
