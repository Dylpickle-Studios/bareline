<section class="repo-shell">
  <header class="repo-header"><div><p class="eyebrow"><%= it.repository.ownerSlug %>/<%= it.repository.slug %></p><h1>Repository settings</h1></div><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>">Back to repository</a></header>
  <div class="settings-sections">
    <section><h2>General</h2><form method="post" class="form-stack"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="details"><label>Description<textarea name="description" maxlength="500"><%= it.repository.description %></textarea></label><label>Default branch<input name="defaultBranch" value="<%= it.repository.defaultBranch %>" required></label><label>Visibility<select name="visibility"><option value="private" <%= it.repository.visibility === 'private' ? 'selected' : '' %>>Private</option><option value="public" <%= it.repository.visibility === 'public' ? 'selected' : '' %>>Public</option></select></label><button class="button" type="submit">Save settings</button></form></section>
    <section><h2>Branch policies</h2><p>Protect an exact branch or prefix such as <code>release/*</code>.</p><form method="post" class="form-stack"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="policy"><label>Branch pattern<input name="refPattern" required placeholder="main"></label><label><input type="checkbox" name="blockForcePush" checked> Block force pushes</label><label><input type="checkbox" name="blockDeletion" checked> Block deletion</label><label><input type="checkbox" name="requireSignedCommits"> Require signed commits (disables web commits)</label><label>Required message prefix<input name="commitMessagePrefix" maxlength="200" placeholder="PROJ-"></label><button class="button">Save policy</button></form><ul class="credential-list"><% it.policies.forEach(function(policy) { %><li><span><strong><%= policy.refPattern %></strong> · <%= policy.blockForcePush ? 'no force push' : 'force push allowed' %> · <%= policy.blockDeletion ? 'no delete' : 'delete allowed' %></span><form method="post"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="removePolicy"><input type="hidden" name="refPattern" value="<%= policy.refPattern %>"><button class="quiet danger">Remove</button></form></li><% }) %></ul></section>
    <section><h2>Deploy keys</h2><p>Deploy keys are read-only and limited to this repository.</p><form method="post" class="form-stack"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="deployKey"><label>Name<input name="name" required maxlength="100"></label><label>SSH public key<textarea name="publicKey" required rows="4"></textarea></label><button class="button">Add deploy key</button></form><ul class="credential-list"><% it.deployKeys.forEach(function(key) { %><li><span><strong><%= key.name %></strong> · <code><%= key.fingerprint %></code></span><form method="post"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="removeDeployKey"><input type="hidden" name="keyId" value="<%= key.id %>"><button class="quiet danger">Remove</button></form></li><% }) %></ul></section>
    <section><h2>Mirror</h2><p>Synchronize with one HTTPS or SSH remote. Credentials come from server Git configuration, never the URL.</p><form method="post" class="form-stack"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="mirror"><label>Direction<select name="direction"><option value="pull">Pull into Bareline</option><option value="push" <%= it.mirror?.direction === 'push' ? 'selected' : '' %>>Push from Bareline</option></select></label><label>Remote URL<input name="remoteUrl" value="<%= it.mirror?.remoteUrl || '' %>" required></label><label>Interval (minutes)<input type="number" name="intervalMinutes" min="5" max="10080" value="<%= it.mirror?.intervalMinutes || 60 %>"></label><button class="button">Save mirror</button></form><% if (it.mirror) { %><p><%= it.mirror.lastSuccessAt ? `Last synchronized ${it.mirror.lastSuccessAt}` : 'Not synchronized yet' %><%= it.mirror.lastError ? ` · ${it.mirror.lastError}` : '' %></p><form method="post"><input type="hidden" name="csrf" value="<%= it.csrf %>"><button class="button" name="action" value="runMirror">Run now</button> <button class="button danger" name="action" value="removeMirror" data-confirm="Remove mirror configuration?">Remove</button></form><% } %></section>
    <section><h2>Template repository</h2><form method="post"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="template"><label><input type="checkbox" name="enabled" <%= it.isTemplate ? 'checked' : '' %>> Allow use as a repository template</label> <button class="button">Save</button></form></section>
    <section><h2>Collaborators</h2><form method="post" class="credential-form"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="grant"><label>Type<select name="principalType"><option value="user">User</option><option value="group">Group</option></select></label><label>Name<input name="principalName" required></label><label>Permission<select name="level"><option value="read">Read</option><option value="write">Write</option><option value="admin">Admin</option></select></label><button class="button">Add or update</button></form><ul class="credential-list"><% it.grants.forEach(function(grant) { %><li><span><strong><%= grant.name %></strong> · <%= grant.principalType %> · <%= grant.level %></span><form method="post"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="removeGrant"><input type="hidden" name="principalType" value="<%= grant.principalType %>"><input type="hidden" name="principalId" value="<%= grant.principalId %>"><button class="quiet danger">Remove</button></form></li><% }) %></ul></section>
    <section><h2>Rename and transfer</h2><form method="post" class="credential-form"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="rename"><label>Repository name<input name="slug" value="<%= it.repository.slug %>" required></label><button class="button">Rename</button></form><form method="post" class="credential-form"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="transfer"><label>Owner type<select name="ownerType"><option value="user">My account</option><option value="group">Group</option></select></label><label>Owner name<input name="ownerSlug" required></label><button class="button" data-confirm="Transfer repository ownership?">Transfer</button></form></section>
    <section class="danger-zone"><h2>Danger zone</h2><p>Deletion moves hosted Git data to configured trash.</p><form method="post"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="delete"><label>Type the repository name<input name="confirmation" required></label><button class="button danger" data-confirm="Move this repository to trash?">Delete repository</button></form></section>
  </div>
</section>
