<section class="repo-shell">
  <header class="repo-header"><div><p class="eyebrow">Directory</p><h1><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>"><%= it.repository.ownerSlug %>/<%= it.repository.slug %></a></h1></div><form class="ref-selector" method="get"><select name="ref" aria-label="Reference"><optgroup label="Branches"><% it.branches.forEach(function(branch) { %><option value="<%= branch.name %>" <%= branch.name === it.ref ? 'selected' : '' %>><%= branch.name %></option><% }) %></optgroup><optgroup label="Tags"><% it.tags.forEach(function(tag) { %><option value="<%= tag.name %>" <%= tag.name === it.ref ? 'selected' : '' %>><%= tag.name %></option><% }) %></optgroup></select><button class="quiet" type="submit">Switch</button></form></header>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>">root</a><% it.breadcrumbs.forEach(function(item) { %><span>/</span><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/tree/<%= item.encodedPath %>?ref=<%= encodeURIComponent(it.ref) %>"><%= item.name %></a><% }) %></nav>
  <ul class="file-tree"><% it.entries.forEach(function(entry) { %><li><span class="file-icon" aria-hidden="true"><%= entry.type === 'tree' ? '▰' : entry.type === 'commit' ? '↗' : '·' %></span><% if (entry.type === 'commit') { %><span><strong><%= entry.name.split('/').at(-1) %></strong> <span class="muted">submodule at <%= entry.objectId.slice(0, 12) %></span><% if (entry.submoduleUrl) { %><br><% if (entry.submoduleLink) { %><a href="<%= entry.submoduleLink %>" rel="nofollow noreferrer"><%= entry.submoduleUrl %></a><% } else { %><code><%= entry.submoduleUrl %></code><% } %><% } %></span><% } else { %><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/<%= entry.type === 'tree' ? 'tree' : 'blob' %>/<%= entry.encodedName %>?ref=<%= encodeURIComponent(it.ref) %>"><%= entry.name.split('/').at(-1) %></a><% } %><span class="size"><%= entry.size === null ? '' : entry.size %></span></li><% }) %></ul>
</section>
