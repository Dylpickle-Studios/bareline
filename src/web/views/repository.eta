<section class="repo-shell">
  <header class="repo-header">
    <div><p class="eyebrow"><%= it.repository.visibility %> repository</p><h1><a href="/<%= it.repository.ownerSlug %>"><%= it.repository.ownerSlug %></a><span>/</span><strong><%= it.repository.slug %></strong></h1></div>
    <details class="clone-menu"><summary class="button">Clone</summary><div class="clone-panel"><h2>Clone repository</h2><label>HTTPS<span class="copy-field"><input readonly value="<%= it.httpsCloneUrl %>"><button class="quiet" type="button" data-copy="<%= it.httpsCloneUrl %>">Copy</button></span></label><pre><code>git clone <%= it.httpsCloneUrl %></code></pre><% if (it.sshCloneUrl) { %><label>SSH<span class="copy-field"><input readonly value="<%= it.sshCloneUrl %>"><button class="quiet" type="button" data-copy="<%= it.sshCloneUrl %>">Copy</button></span></label><pre><code>git clone <%= it.sshCloneUrl %></code></pre><% } %></div></details>
  </header>
  <% if (it.repository.description) { %><p class="repo-description"><%= it.repository.description %></p><% } %>
  <nav class="repo-nav" aria-label="Repository"><a aria-current="page" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>">Code</a><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commits">Commits</a><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/branches">Branches</a><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/tags">Tags</a><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/compare">Compare</a><% it.pluginTabs.forEach(function(tab) { %><a href="<%= tab.url %>"><%= tab.title %></a><% }) %><% if (it.canAdmin) { %><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/settings">Settings</a><% } %></nav>
  <% if (it.empty) { %>
    <div class="empty"><h2>This repository is ready</h2><p>Push an existing repository:</p><pre><code>git remote add origin <%= it.cloneUrl %>\ngit push -u origin <%= it.repository.defaultBranch %></code></pre></div>
  <% } else { %>
    <div class="tree-toolbar"><form class="ref-selector" method="get"><label><span class="sr-only">Reference</span><select name="ref"><optgroup label="Branches"><% it.branches.forEach(function(branch) { %><option value="<%= branch.name %>" <%= branch.name === it.ref ? 'selected' : '' %>><%= branch.name %></option><% }) %></optgroup><optgroup label="Tags"><% it.tags.forEach(function(tag) { %><option value="<%= tag.name %>" <%= tag.name === it.ref ? 'selected' : '' %>><%= tag.name %></option><% }) %></optgroup></select></label><button class="quiet" type="submit">Switch</button></form><span class="actions"><span class="muted"><%= it.entries.length %> items</span><% if (it.canWrite) { %><a class="button" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/files/new?ref=<%= encodeURIComponent(it.ref) %>">New file</a><a class="button" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/files/upload?ref=<%= encodeURIComponent(it.ref) %>">Upload</a><% } %></span></div>
    <% if (it.latestCommit) { %><div class="latest-commit"><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commit/<%= it.latestCommit.objectId %>"><%= it.latestCommit.subject %></a><span><%= it.latestCommit.authorName %> · <time datetime="<%= it.latestCommit.authoredAt %>" title="<%= it.latestCommit.authoredAt %>"><%= it.latestCommit.relativeDate %></time></span></div><% } %>
    <ul class="file-tree">
      <% it.entries.forEach(function(entry) { %><li><span class="file-icon" aria-hidden="true"><%= entry.type === 'tree' ? '▰' : entry.type === 'commit' ? '↗' : '·' %></span><% if (entry.type === 'commit') { %><span><strong><%= entry.name %></strong> <span class="muted">submodule at <%= entry.objectId.slice(0, 12) %></span><% if (entry.submoduleUrl) { %><br><% if (entry.submoduleLink) { %><a href="<%= entry.submoduleLink %>" rel="nofollow noreferrer"><%= entry.submoduleUrl %></a><% } else { %><code><%= entry.submoduleUrl %></code><% } %><% } %></span><% } else { %><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/<%= entry.type === 'tree' ? 'tree' : 'blob' %>/<%= entry.encodedName %>?ref=<%= encodeURIComponent(it.ref) %>"><%= entry.name %></a><% } %><span class="size"><%= entry.size === null ? '' : entry.size %></span></li><% }) %>
    </ul>
    <% if (it.readme) { %><article class="readme markdown-body"><header>README</header><% if (it.renderedReadme) { %><%~ it.renderedReadme %><% } else { %><pre><code><%= it.readme %></code></pre><% } %></article><% } %>
    <% if (it.readmeTooLarge) { %><div class="notice">README preview omitted because the file exceeds the configured preview limit. Open the file to request a bounded large preview.</div><% } %>
  <% } %>
</section>
