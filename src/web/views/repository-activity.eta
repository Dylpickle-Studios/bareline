<section class="repo-shell"><header class="repo-header"><div><p class="eyebrow"><%= it.repository.ownerSlug %>/<%= it.repository.slug %></p><h1>Repository activity</h1></div><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>">Back to repository</a></header><ol class="commit-list"><% it.events.forEach(function(event) { %><li><strong><%= event.action %></strong><span><%= event.username || 'System' %><%= event.refName ? ` · ${event.refName}` : '' %></span><time datetime="<%= event.createdAt %>"><%= event.createdAt %></time></li><% }) %></ol><% if (!it.events.length) { %><div class="empty"><h2>No activity yet</h2><p>New repository events will appear here.</p></div><% } %></section>
