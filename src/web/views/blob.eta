<section class="repo-shell">
  <header class="repo-header"><div><p class="eyebrow">File at <%= it.ref %></p><h1><%= it.path.split('/').at(-1) %></h1></div><div class="actions"><form class="ref-selector" method="get"><select name="ref" aria-label="Reference"><optgroup label="Branches"><% it.branches.forEach(function(branch) { %><option value="<%= branch.name %>" <%= branch.name === it.ref ? 'selected' : '' %>><%= branch.name %></option><% }) %></optgroup><optgroup label="Tags"><% it.tags.forEach(function(tag) { %><option value="<%= tag.name %>" <%= tag.name === it.ref ? 'selected' : '' %>><%= tag.name %></option><% }) %></optgroup></select><button class="quiet" type="submit">Switch</button></form><a class="button" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/history/<%= it.encodedPath %>?ref=<%= encodeURIComponent(it.ref) %>">History</a><a class="button" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/blame/<%= it.encodedPath %>?ref=<%= encodeURIComponent(it.ref) %>">Blame</a><% if (it.canWrite) { %><a class="button" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/edit/<%= it.encodedPath %>?ref=<%= encodeURIComponent(it.ref) %>">Edit</a><% } %><a class="button" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/raw/<%= it.encodedPath %>?ref=<%= encodeURIComponent(it.ref) %>">Raw</a><a class="button" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/raw/<%= it.encodedPath %>?ref=<%= encodeURIComponent(it.ref) %>&download=1">Download</a></div></header>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>"><%= it.repository.slug %></a><% it.breadcrumbs.forEach(function(item, index) { %><span>/</span><% if (index === it.breadcrumbs.length - 1) { %><span aria-current="page"><%= item.name %></span><% } else { %><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/tree/<%= item.encodedPath %>?ref=<%= encodeURIComponent(it.ref) %>"><%= item.name %></a><% } %><% }) %></nav>
  <p class="muted"><%= it.size %> bytes</p>
  <% if (it.pluginRenderers.length) { %><nav class="plugin-renderers" aria-label="Plugin file renderers"><span>Open with</span><% it.pluginRenderers.forEach(function(renderer) { %><a class="quiet" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/plugins/<%= renderer.pluginId %>/renderers/<%= renderer.id %>/<%= it.encodedPath %>?ref=<%= encodeURIComponent(it.ref) %>"><%= renderer.title %></a><% }) %></nav><% } %>
  <% if (it.kind === 'too-large') { %><div class="notice"><h2>This file is unusually large</h2><p>The normal preview limit protects the server and browser. <% if (it.size) { %>This blob is <%= it.size %> bytes.<% } %></p><div class="actions"><% if (it.canLoadLarge) { %><a class="button" href="?ref=<%= encodeURIComponent(it.ref) %>&large=1">Load bounded preview</a><% } %><a class="button" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/raw/<%= it.encodedPath %>?ref=<%= encodeURIComponent(it.ref) %>&download=1">Download</a></div></div>
  <% } else if (it.kind === 'lfs') { %><div class="lfs-card"><p class="eyebrow">Git LFS pointer</p><h2><%= it.lfsPointer.size %> bytes</h2><code>sha256:<%= it.lfsPointer.objectId %></code><p><%= it.lfsAvailable ? 'The object is available from this server through Git LFS.' : 'The referenced object is not available in local LFS storage.' %></p></div>
  <% } else if (it.kind === 'markdown') { %><article class="markdown-body"><%~ it.rendered %></article>
  <% } else if (it.kind === 'image') { %><div class="image-preview"><% if (it.imageMetadata) { %><p class="muted"><%= it.imageMetadata.format %> · <%= it.imageMetadata.width %> × <%= it.imageMetadata.height %> px · <%= it.size %> bytes</p><% } %><img src="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/raw/<%= it.encodedPath %>?ref=<%= encodeURIComponent(it.ref) %>" alt="Preview of <%= it.path %>"></div>
  <% } else if (it.kind === 'binary') { %><div class="empty"><h2>Binary file</h2><p>This file cannot be displayed safely in the browser.</p></div>
  <% } else { %><div class="code-view" role="region" aria-label="File contents" tabindex="0"><ol><% it.lines.forEach(function(line, index) { %><li id="L<%= index + 1 %>"><a class="line-number" href="#L<%= index + 1 %>" aria-label="Line <%= index + 1 %>"><%= index + 1 %></a><code><%~ line %></code></li><% }) %></ol></div><% } %>
</section>
