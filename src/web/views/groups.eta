<section class="settings-shell"><nav class="settings-nav" aria-label="Groups"><a aria-current="page" href="/groups">Your groups</a><a href="/groups/new">Create group</a></nav><div class="settings-content"><h1>Your groups</h1><ul class="credential-list"><% it.groups.forEach(function(group) { %><li><a href="/groups/<%= group.slug %>/settings"><strong><%= group.displayName %></strong><br><code><%= group.slug %></code> · <%= group.role %></a></li><% }) %></ul></div></section>
