<section class="admin-shell"><nav class="settings-nav" aria-label="Administration"><a aria-current="page" href="/admin">Overview</a><a href="/admin/users">Users</a><a href="/admin/repositories">Repositories</a><a href="/admin/plugins">Plugins</a><a href="/admin/audit">Audit log</a><a href="/admin/search">Search index</a></nav><div class="settings-content"><header><p class="eyebrow">Administration</p><h1>System overview</h1></header><div class="stat-grid"><% Object.entries(it.counts).forEach(function(pair) { %><article><strong><%= pair[1] %></strong><span><%= pair[0] %></span></article><% }) %></div><dl class="system-list"><div><dt>Application</dt><dd><%= it.product.version %></dd></div><div><dt>Node.js</dt><dd><%= it.system.node %></dd></div><div><dt>Git</dt><dd><%= it.system.git %></dd></div><div><dt>SQLite</dt><dd><%= it.system.sqlite %> · WAL <%= it.system.journal %></dd></div><div><dt>Repository storage</dt><dd><code><%= it.system.repositoryStorage %></code></dd></div><div><dt>SSH</dt><dd><%= it.system.ssh ? 'Enabled' : 'Disabled' %></dd></div></dl></div></section>
