<section class="narrow"><h1>Create group</h1><form method="post" class="form-stack"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label>Group handle<input name="slug" pattern="[a-z0-9-]+" maxlength="39" required></label><label>Display name<input name="displayName" maxlength="100" required></label><button class="button primary" type="submit">Create group</button></form></section>
