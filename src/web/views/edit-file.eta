<section class="repo-shell narrow-wide">
  <header><p class="eyebrow"><%= it.exists ? 'Edit file' : 'Create file' %></p><h1><%= it.exists ? it.path : 'New file' %></h1></header>
  <% if (it.error) { %><div class="notice error" role="alert"><%= it.error %></div><% } %>
  <form method="post" class="form-stack">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <% if (!it.exists) { %><label>Path<input name="path" value="<%= it.path %>" required maxlength="4096" placeholder="docs/guide.md"></label><% } %>
    <label>Branch<input name="branch" value="<%= it.ref %>" required maxlength="255"></label>
    <label>Contents<textarea name="content" rows="24" spellcheck="false"><%= it.content %></textarea></label>
    <label>Commit message<input name="message" value="<%= it.exists ? `Update ${it.path}` : 'Create file' %>" required maxlength="10000"></label>
    <div class="actions"><button class="button primary" name="action" value="save" type="submit">Commit changes</button><% if (it.exists) { %><button class="button danger" name="action" value="delete" type="submit" data-confirm="Delete this file with a new commit?">Delete file</button><% } %></div>
  </form>
</section>
