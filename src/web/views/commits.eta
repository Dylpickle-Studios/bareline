<section class="repo-shell">
  <header class="repo-header"><div><p class="eyebrow">Commit history</p><h1><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>"><%= it.repository.ownerSlug %>/<%= it.repository.slug %></a></h1></div><form class="ref-selector" method="get"><select name="ref" aria-label="Reference"><optgroup label="Branches"><% it.branches.forEach(function(branch) { %><option value="<%= branch.name %>" <%= branch.name === it.ref ? 'selected' : '' %>><%= branch.name %></option><% }) %></optgroup><optgroup label="Tags"><% it.tags.forEach(function(tag) { %><option value="<%= tag.name %>" <%= tag.name === it.ref ? 'selected' : '' %>><%= tag.name %></option><% }) %></optgroup></select><button class="quiet" type="submit">Switch</button></form></header>
  <ol class="commit-list">
  <% it.commits.forEach(function(commit) { %><li><% if (commit.avatarUrl) { %><img class="commit-avatar" src="<%= commit.avatarUrl %>" width="32" height="32" alt=""><% } %><div><a class="commit-subject" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commit/<%= commit.objectId %>"><%= commit.subject %></a><p><%= commit.authorName %> committed <time datetime="<%= commit.authoredAt %>" title="<%= commit.authoredAt %>"><%= commit.relativeDate %></time></p></div><a class="sha" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commit/<%= commit.objectId %>"><%= commit.shortId %></a></li><% }) %>
  </ol>
</section>
