<section class="repo-shell">
  <header><p class="eyebrow"><%= it.repository.ownerSlug %>/<%= it.repository.slug %> · <code><%= it.release.tagName %></code></p><h1><%= it.release.name || it.release.tagName %></h1><p class="muted">Published <time datetime="<%= it.release.createdAt %>"><%= it.release.createdAt %></time> at <a class="sha" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commit/<%= it.release.objectId %>"><%= it.release.objectId.slice(0, 12) %></a></p></header>
  <% if (it.renderedBody) { %><article class="markdown-body"><%~ it.renderedBody %></article><% } %>
  <h2>Assets</h2>
  <% if (!it.release.assets.length) { %><p class="muted">No assets uploaded.</p><% } %>
  <ul class="ref-list">
    <% it.release.assets.forEach(function(asset) { %>
      <li><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/releases/<%= encodeURIComponent(it.release.tagName) %>/assets/<%= asset.id %>"><%= asset.filename %></a><span class="muted"><%= asset.size %> bytes</span></li>
    <% }) %>
  </ul>
  <% if (it.canWrite) { %>
  <form method="post" action="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/releases/<%= encodeURIComponent(it.release.tagName) %>/assets" enctype="multipart/form-data" class="form-stack">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <label>Upload asset<input name="file" type="file" required></label>
    <button class="button" type="submit">Upload</button>
  </form>
  <form method="post" action="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/releases/<%= encodeURIComponent(it.release.tagName) %>/delete" data-confirm="Delete this release and its assets?">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <button class="button danger" type="submit">Delete release</button>
  </form>
  <% } %>
</section>
