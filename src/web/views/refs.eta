<section class="repo-shell">
  <header><p class="eyebrow"><%= it.kind %></p><h1><a href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>"><%= it.repository.ownerSlug %>/<%= it.repository.slug %></a></h1></header>
  <% if (it.canWrite) { %><form method="post" class="ref-create"><input type="hidden" name="csrf" value="<%= it.csrf %>"><label>Name<input name="name" required maxlength="255"></label><label>Start at<input name="source" value="<%= it.repository.defaultBranch %>" required maxlength="255"></label><button class="button" type="submit">Create <%= it.kind === 'Branches' ? 'branch' : 'tag' %></button></form><% } %>
  <ul class="ref-list"><% it.refs.forEach(function(ref) { %><li><div><strong class="branch"><%= ref.name %></strong><p><%= ref.subject %> · <time datetime="<%= ref.committedAt %>" title="<%= ref.committedAt %>"><%= ref.relativeDate %></time></p><% if (ref.signature) { %><p><span class="signature signature-<%= ref.signature.state %>"><%= ref.signature.label %></span><% if (ref.signature.signer) { %> · <%= ref.signature.signer %><% } %></p><% } %></div><span class="actions"><a class="sha" href="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/commit/<%= ref.objectId %>"><%= ref.objectId.slice(0, 8) %></a><% if (it.canWrite && !(it.kind === 'Branches' && ref.name === it.repository.defaultBranch)) { %><form method="post" action="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/<%= it.kind === 'Branches' ? 'branches' : 'tags' %>/delete"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="name" value="<%= ref.name %>"><button class="quiet danger" type="submit" data-confirm="Delete <%= ref.name %>?">Delete</button></form><% } %></span></li><% }) %></ul>
</section>
