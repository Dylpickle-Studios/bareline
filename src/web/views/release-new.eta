<section class="repo-shell narrow-wide">
  <header><p class="eyebrow"><%= it.repository.ownerSlug %>/<%= it.repository.slug %></p><h1>Draft a new release</h1></header>
  <% if (it.error) { %><div class="notice error" role="alert"><%= it.error %></div><% } %>
  <form method="post" action="/<%= it.repository.ownerSlug %>/<%= it.repository.slug %>/releases" class="form-stack">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <label>Tag<input name="tagName" required maxlength="255" placeholder="v1.0.0"></label>
    <label>Target (used only when the tag does not already exist)<input name="ref" value="<%= it.ref %>" maxlength="255"></label>
    <label>Title<input name="name" maxlength="255"></label>
    <label>Release notes<textarea name="body" rows="12" spellcheck="true"></textarea></label>
    <button class="button primary" type="submit">Publish release</button>
  </form>
</section>
