<section class="admin-shell"><nav class="settings-nav" aria-label="Administration"><a href="/admin">Overview</a><a href="/admin/users">Users</a><a href="/admin/repositories">Repositories</a><a href="/admin/plugins">Plugins</a><a aria-current="page" href="/admin/audit">Audit log</a></nav><div class="settings-content"><h1>Audit log</h1><div class="responsive-table"><table><thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Target</th><th>Metadata</th></tr></thead><tbody><% it.events.forEach(function(event) { %><tr><td><%= event.createdAt %></td><td><%= event.actor ?? 'system' %></td><td><code><%= event.action %></code></td><td><%= event.targetType %>:<%= event.targetId ?? '' %></td><td><code><%= event.metadata %></code></td></tr><% }) %></tbody></table></div></div></section>
