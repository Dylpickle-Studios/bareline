<section class="settings-shell"><nav class="settings-nav" aria-label="Group settings"><a href="/groups">Your groups</a><a aria-current="page" href="/groups/<%= it.group.slug %>/settings"><%= it.group.displayName %></a></nav><div class="settings-content"><p class="eyebrow">Group</p><h1><%= it.group.displayName %></h1><p><code><%= it.group.slug %></code> · your role: <%= it.group.role %></p><h2>Members</h2><% if (it.canManage) { %><form method="post" class="credential-form"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="add"><label>Username<input name="username" required></label><label>Role<select name="role"><option value="member">Member</option><option value="manager">Manager</option><% if (it.group.role === 'owner') { %><option value="owner">Owner</option><% } %></select></label><button class="button" type="submit">Add or update</button></form><% } %><ul class="credential-list"><% it.group.members.forEach(function(member) { %><li><span><strong><%= member.displayName %></strong> · <code><%= member.username %></code> · <%= member.role %></span><% if (it.canManage) { %><form method="post"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="action" value="remove"><input type="hidden" name="userId" value="<%= member.id %>"><button class="quiet danger" type="submit">Remove</button></form><% } %></li><% }) %></ul></div></section>
